configuration {
    modi:                "drun,run";
    show-icons:          false;
    drun-display-format: "{name}";
    display-drun:        "apps";
    display-run:         "run";
    font:                "MesloLGS Nerd Font Mono 10";

    /* vim-style: Ctrl+j down, Ctrl+k up (taken from accept and delete-to-end) */
    kb-row-down:         "Down,Control+n,Control+j";
    kb-row-up:           "Up,Control+p,Control+k";
    kb-accept-entry:     "Control+m,Return,KP_Enter";
    kb-remove-to-eol:    "";
}

/* layout; colors come from colors.rasi, which follows the kitty theme */
@theme "~/.config/rofi/theme.rasi"
