# i3lock-color colors: {{scheme-name}} (written by apply-scheme for tinty; edits are overwritten).
# Read by blur-lock: one i3lock option per line (# lines skipped). Colors are RRGGBBAA.
# waiting: the accent ring around a see-through background
--ring-color={{base0D-hex}}ff
--inside-color={{base00-hex}}aa
# a key pressed / backspace: a segment of the ring lights up
--keyhl-color={{base0A-hex}}ff
--bshl-color={{base09-hex}}ff
# checking the password
--ringver-color={{base0C-hex}}ff
--insidever-color={{base00-hex}}aa
# wrong password
--ringwrong-color={{base08-hex}}ff
--insidewrong-color={{base08-hex}}55
# no lines between the ring and the inside
--line-color=00000000
--separator-color=00000000
