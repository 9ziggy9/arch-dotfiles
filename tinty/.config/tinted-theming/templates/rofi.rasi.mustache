/* rofi colors: {{scheme-name}} (written by apply-scheme for tinty; edits are overwritten).
   Imported by theme.rasi. */
* {
    bg:      #{{base00-hex}};
    fg:      #{{base05-hex}};
    alt-bg:  #{{base01-hex}};
    dim:     #{{base04-hex}};
    sel-bg:  #{{base0A-hex}};
    sel-fg:  #{{on-base0A-hex}};
    accent:  #{{base0D-hex}};
    urgent:  #{{base08-hex}};
    frame:   #{{base05-hex}};
}
