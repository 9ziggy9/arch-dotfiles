#!/usr/bin/env bash
# Pick a base16/base24 color scheme with rofi and switch everything to it
# through tinty: kitty, the shell, i3 and its bar, rofi, qutebrowser and
# emacs. Bound to $mod+Shift+t in i3.
#
#   theme-select           pick with rofi
#   theme-select SCHEME    switch straight to SCHEME, e.g. base16-nord
#
# What each program gets is a template in ~/.config/tinted-theming/templates,
# filled in, with any unreadable colors adjusted, by ~/.config/tinted-theming/
# apply-scheme (tinty runs it; see its tinty/config.toml).

export PATH="$HOME/.cargo/bin:$PATH"   # tinty; X sessions don't read .zshrc
scheme_template="$HOME/.config/tinted-theming/scheme"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/theme-select"
mkdir -p "$cache"

fail() { notify-send -u critical "theme" "$1" 2>/dev/null; echo "$1" >&2; exit 1; }

command -v tinty >/dev/null || fail "tinty is not installed: cargo install --locked tinty"

# The schemes and templates, fetched or linked in on first use
if [ ! -d "$(tinty config --data-dir-path)/scheme-repos/schemes" ]; then
    tinty sync -q || fail "tinty sync failed"
fi

# The scheme JSON apply-scheme reads is rendered for every scheme ahead of
# time (about a second), and again whenever its template changes
built="$cache/built"
if [ ! -e "$built" ] || [ -n "$(find -L "$scheme_template" -path '*/themes' -prune -o -type f -newer "$built" -print -quit)" ]; then
    tinty build -q || fail "tinty build failed"
    touch "$built"
fi

# Every scheme as "ID BACKGROUND FOREGROUND", so each row of the picker can
# show the scheme's own colors (base16 and base24 only: the templates don't
# do tinty's newer tinted8 schemes, whose colors have other names)
schemes="$cache/schemes"
if [ ! -s "$schemes" ] || [ "$built" -nt "$schemes" ]; then
    tinty list --json | python3 -Ic '
import json, sys
for s in sorted(json.load(sys.stdin), key=lambda s: s["id"]):
    if s["system"] not in ("base16", "base24"):
        continue
    p = s["palette"]
    print(s["id"], p["base00"]["hex_str"], p["base05"]["hex_str"])' > "$schemes.tmp" \
        && mv "$schemes.tmp" "$schemes" || fail "Could not list the schemes"
fi

current="$(tinty current 2>/dev/null)"

choice="$1"
if [ -z "$choice" ]; then
    row="$(awk -v c="$current" '$1==c{print NR-1; f=1; exit} END{if(!f) print 0}' "$schemes")"
    # Rows are pango markup: the name on a band of the scheme's own colors,
    # padded with spaces so the band runs the width of the popup. rofi hands
    # back the row number (-format i), which picks the scheme from the list.
    # The selected row shows as a ring of the selection color around its band.
    width=95   # characters across a row of the 768px popup (no margin) in its 10pt mono font
    picked="$(awk -v w="$width" '{ printf "<span background=\"%s\" foreground=\"%s\"> %-*s</span>\n", $2, $3, w-1, $1 }' "$schemes" \
      | rofi -dmenu -i -no-show-icons -markup-rows -format i -p "theme" \
          -mesg "current: ${current:-?}" -selected-row "$row" \
          -theme-str 'element { padding: 3px; }
                      element normal.normal, element alternate.normal { background-color: @bg; }
                      element-text { background-color: transparent; }')"
    [ -z "$picked" ] && exit 0
    choice="$(awk -v n="$((picked + 1))" 'NR==n{print $1}' "$schemes")"
fi
awk -v c="$choice" '$1==c{f=1} END{exit !f}' "$schemes" || fail "No such scheme: $choice"

# Every program's colors, each reloaded by its hook (config.toml)
tinty apply "$choice" || fail "tinty apply $choice failed"
