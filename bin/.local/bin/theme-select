#!/usr/bin/env bash
# Pick an emacs theme with rofi and switch everything to it: emacs, kitty, the
# status bar and rofi itself. Bound to $mod+Shift+t in i3.
#
#   theme-select           pick with rofi
#   theme-select THEME     switch straight to THEME
#
# Kitty's colors are made from the emacs theme by
# ~/.config/kitty/emacs-theme-to-kitty.el; the bar and rofi colors are made
# from kitty's.

kitty_dir="$HOME/.config/kitty"
emacs_dir="$HOME/.config/emacs"
converter="$kitty_dir/emacs-theme-to-kitty.el"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/theme-select"
mkdir -p "$cache"

convert() { /usr/bin/emacs --batch -Q -l "$converter" "$@" 2>/dev/null; }
fail() { notify-send -u critical "theme" "$1" 2>/dev/null; echo "$1" >&2; exit 1; }

# Emacs theme names, re-listed only after packages or the converter change
list="$cache/emacs-themes"
if [ ! -s "$list" ] || [ -n "$(find -H "$emacs_dir/elpa" "$converter" -maxdepth 1 -newer "$list" -print -quit)" ]; then
    convert --list > "$list.tmp" && mv "$list.tmp" "$list"
fi

# Each theme's background and foreground ("THEME BG FG" lines), so the picker
# can show every row in its own theme's colors; remade along with the list
colors="$cache/emacs-theme-colors"
if [ ! -s "$colors" ] || [ "$list" -nt "$colors" ]; then
    convert --colors > "$colors.tmp" && mv "$colors.tmp" "$colors"
fi

current="$(cat "$emacs_dir/theme" 2>/dev/null)"

choice="$1"
if [ -z "$choice" ]; then
    row="$(awk -v c="$current" '$0==c{print NR-1; f=1; exit} END{if(!f) print 0}' "$list")"
    # Rows are pango markup: the name on a band of the theme's own colors,
    # padded with spaces so the band runs the width of the popup. rofi hands
    # back the row number (-format i), which picks the name from the list.
    # The selected row shows as a ring of the selection color around its band.
    width=95   # characters across a row of the 768px popup (no margin) in its 10pt mono font
    picked="$(awk -v w="$width" 'NR==FNR { bg[$1]=$2; fg[$1]=$3; next }
        { t=$0; gsub(/&/,"\\&amp;",t); gsub(/</,"\\&lt;",t)
          b=($0 in bg) ? bg[$0] : "#000000"; f=($0 in fg) ? fg[$0] : "#ffffff"
          printf "<span background=\"%s\" foreground=\"%s\"> %-*s</span>\n", b, f, w-1, t }' \
        "$colors" "$list" \
      | rofi -dmenu -i -no-show-icons -markup-rows -format i -p "theme" \
          -mesg "current: ${current:-?}" -selected-row "$row" \
          -theme-str 'element { padding: 3px; }
                      element normal.normal, element alternate.normal { background-color: @bg; }
                      element-text { background-color: transparent; }')"
    [ -z "$picked" ] && exit 0
    choice="$(sed -n "$((picked + 1))p" "$list")"
fi
grep -qxF "$choice" "$list" || fail "No such theme: $choice"

# kitty: convert the emacs theme (once; kept in the cache) and reload
src="$cache/$choice.conf"
if [ ! -s "$src" ] || [ "$converter" -nt "$src" ]; then
    convert "$choice" > "$src.tmp" && grep -q '^color15 ' "$src.tmp" \
        || { rm -f "$src.tmp"; fail "Could not convert emacs theme $choice"; }
    mv "$src.tmp" "$src"
fi
cp "$src" "$kitty_dir/current-theme.conf"
pkill -USR1 -x kitty            # every running kitty reloads its config

# rofi and the status bar take their colors from kitty's
"$HOME/.config/rofi/kitty-colors.sh"
python3 -I "$HOME/.config/bumblebee-status/bar-theme.py"
i3-msg -q restart               # restarts the bar with the new colors (windows stay put)

# qutebrowser reads kitty's colors in its config.py: reload it if it is running
# (only then: the qutebrowser command would otherwise start a new browser)
if pgrep -f '^(/usr/bin/)?python3? .*/usr/bin/qutebrowser' >/dev/null; then
    qutebrowser ':config-source' >/dev/null 2>&1 &
fi

# emacs: new frames open in the theme's colors rather than flashing white
# (read by early-init.el); kitty's colors came from this theme, so they match
bg="$(awk '$1=="background"{print $2; exit}' "$src")"
fg="$(awk '$1=="foreground"{print $2; exit}' "$src")"
printf '("%s" . "%s")\n' "$bg" "$fg" > "$emacs_dir/theme-colors"

# emacs: switch the running daemon (and the colors its next frames open in),
# which also saves the choice for the next start (my/save-theme in ui.el).
# emacsclient code runs in the daemon's hidden terminal frame, where the theme
# hooks that read colors from the frame (window dividers, mode-line band) see
# none, so the switch runs in an open emacs window; with none open, those
# hooks run again in the next window. Without a daemon, just save the choice.
elisp="$(cat <<ELISP
(let ((gui (seq-find #'display-graphic-p (frame-list))))
  (setf (alist-get 'background-color default-frame-alist) "$bg"
        (alist-get 'foreground-color default-frame-alist) "$fg")
  (with-selected-frame (or gui (selected-frame))
    (mapc #'disable-theme custom-enabled-themes)
    (load-theme '$choice t)
    (my/save-theme '$choice))
  (unless gui
    (defalias 'theme-select--redo
      (lambda ()
        (remove-hook 'server-after-make-frame-hook 'theme-select--redo)
        (run-hook-with-args 'enable-theme-functions '$choice)))
    (add-hook 'server-after-make-frame-hook 'theme-select--redo)))
ELISP
)"
if ! timeout 10 emacsclient -e "$elisp" >/dev/null 2>&1; then
    printf '%s' "$choice" > "$emacs_dir/theme"
fi
exit 0
