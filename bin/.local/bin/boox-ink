#!/usr/bin/env python3
"""boox-ink: show Boox pen strokes live over the mirror, while they're drawn.

    boox-ink SERIAL CROP

Started by boox-screen next to the scrcpy mirror, with its adb serial and
its --crop value; it quits when the mirror window closes.

Boox Notes draws a stroke straight onto the e-ink panel while the pen is
down, past Android's screen output, so scrcpy only sees the stroke once the
pen lifts. Meanwhile this reads the pen itself (the Wacom digitizer, over
adb) and draws the stroke in a click-through window on top of the mirror,
in the color scheme's text color (read from picom's boox.glsl). Once the
real stroke shows up in the mirror under it, the live one is removed.

Only while one of Notes' pens is selected: with the eraser, shapes, fill or
any other tool, nothing is drawn. Notes marks the selected tool with a small
triangle under it; after each tap off the page (pen or finger) the row of
the top toolbar it sits in is read from the Boox, and live ink is on only
when it's under one of the pens.

It's a stand-in: a plain line, whatever kind of pen, and placed for Notes in
landscape at the page's own scale. Output goes to
~/.cache/boox-ink.log (boox-screen sends it there).
"""
import os
import re
import struct
import subprocess
import sys
import threading
import time

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkX11", "3.0")
from gi.repository import GLib, Gdk, GdkX11, Gtk  # noqa: E402

TITLE = "Boox"                  # the mirror window (boox-screen's --window-title)
EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
ABS_X, ABS_Y, ABS_PRESSURE = 0x00, 0x01, 0x18
BTN_TOOL_RUBBER = 0x141         # the pen's eraser end
EVENT = struct.Struct("<qqHHi")  # struct input_event on arm64: 24 bytes

WIDTH_MIN, WIDTH_MAX = 2.0, 5.0  # stroke width in Boox pixels, by pressure
CHECK_EVERY = 150               # ms between looks for the real stroke
GIVE_UP = 4.0                   # s after pen-up to remove the live stroke anyway
CHANGED = 0.6                   # share of the stroke the mirror must show

# Notes' selected-tool marker, in the 2480x1860 landscape screen: the rows
# it fills just above the top toolbar's bottom line, and the stretch of
# that toolbar holding the five pens (the eraser's marker is at x 2141;
# shapes, fill and the rest mark the left sidebar instead)
MARKER_ROWS = (94, 104)
PEN_ZONE = (1400, 2080)
RECHECK = (400, 1200)           # ms after a tap to read the marker
ABS_MT_TRACKING_ID = 0x39


def log(*args):
    print(time.strftime("%H:%M:%S"), *args, file=sys.stderr, flush=True)


def adb(serial, *args):
    return subprocess.run(["adb", "-s", serial, *args], capture_output=True,
                          text=True, timeout=10).stdout


def ink_color():
    """The scheme's text color, as the picom shader turns the mirror's ink."""
    conf = os.path.realpath(os.path.expanduser("~/.config/picom/picom.conf"))
    try:
        with open(os.path.join(os.path.dirname(conf), "boox.glsl")) as f:
            m = re.search(r"vec3 fg = hex\(0x([0-9a-fA-F]{6})\)", f.read())
        h = m.group(1)
        return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except (OSError, AttributeError):
        return (1.0, 1.0, 1.0)


class Pen:
    """The Boox's digitizer: where it is, and how it maps onto the screen."""

    def __init__(self, serial, crop):
        self.serial = serial
        info = adb(serial, "shell", "getevent", "-pl")
        # the device whose name says digitizer, and its axis ranges
        dev = re.search(r"add device \d+: (\S+)\s+name:\s+\"[^\"]*Digitizer[^\"]*\"(.*?)(?=add device|\Z)",
                        info, re.S)
        if not dev:
            sys.exit("boox-ink: no pen digitizer on the Boox")
        self.device = dev.group(1)
        axes = dict(re.findall(r"(ABS_\w+)\s*:.*?max (\d+)", dev.group(2)))
        self.max_x, self.max_y = int(axes["ABS_X"]), int(axes["ABS_Y"])
        self.max_p = int(axes.get("ABS_PRESSURE", 4095))
        w, h = map(int, re.search(r"(\d+)x(\d+)", adb(serial, "shell", "wm", "size")).groups())
        self.screen_w, self.screen_h = max(w, h), min(w, h)   # landscape
        # scrcpy's crop is height:width:top:left of the landscape screen
        ch, cw, top, left = map(int, crop.split(":"))
        self.crop = (left, top, cw, ch)

    def pen_selected(self):
        """Whether Notes has one of its pens selected: True or False, or None
        when the screen couldn't be read. Reads only the marker's rows of a
        raw screenshot (RGBA, after a 16-byte header): about 100 KB."""
        top, bottom = MARKER_ROWS
        row = self.screen_w * 4
        end = 16 + bottom * row
        try:
            data = subprocess.run(
                ["adb", "-s", self.serial, "exec-out",
                 f"screencap | head -c {end} | tail -c {(bottom - top) * row}"],
                capture_output=True, timeout=5).stdout
        except subprocess.TimeoutExpired:
            return None
        if len(data) != (bottom - top) * row:
            return None
        xs = [x for r in range(bottom - top) for x in range(self.crop[0], self.screen_w)
              if data[r * row + x * 4] < 100]
        if not xs:
            return False
        middle = (min(xs) + max(xs)) / 2
        return PEN_ZONE[0] <= middle <= PEN_ZONE[1]

    def read_touch(self, on_lift):
        """Report each finger lift on the touchscreen (in a thread): it may
        have been a tap on a toolbar."""
        info = adb(self.serial, "shell", "getevent", "-pl")
        dev = re.search(r"add device \d+: (\S+)\s+name:[^\n]*\n(?:(?!add device).)*ABS_MT_POSITION_X",
                        info, re.S)
        if not dev:
            log("no touchscreen found: finger taps on the toolbar go unnoticed")
            return
        proc = subprocess.Popen(["adb", "-s", self.serial, "exec-out", "cat", dev.group(1)],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        buf = b""
        while True:
            chunk = proc.stdout.read1(4096)
            if not chunk:
                break
            buf += chunk
            n = len(buf) // EVENT.size * EVENT.size
            for _, _, type_, code, value in EVENT.iter_unpack(buf[:n]):
                if type_ == EV_ABS and code == ABS_MT_TRACKING_ID and value == -1:
                    GLib.idle_add(on_lift)
            buf = buf[n:]

    def to_content(self, x, y):
        """Digitizer to the cropped landscape picture. Both axes run backwards
        (measured: the digitizer's origin is the screen's bottom right)."""
        sx = (self.max_x - x) * self.screen_w / self.max_x
        sy = (self.max_y - y) * self.screen_h / self.max_y
        return sx - self.crop[0], sy - self.crop[1]

    def read(self, on_point, on_up):
        """Stream pen events (in a thread); report each point while the pen
        is down, and the lift."""
        proc = subprocess.Popen(["adb", "-s", self.serial, "exec-out", "cat", self.device],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        x = y = p = 0
        rubber = down = False
        buf = b""
        while True:
            chunk = proc.stdout.read1(4096)
            if not chunk:
                break
            buf += chunk
            n = len(buf) // EVENT.size * EVENT.size
            for _, _, type_, code, value in EVENT.iter_unpack(buf[:n]):
                if type_ == EV_ABS:
                    if code == ABS_X:
                        x = value
                    elif code == ABS_Y:
                        y = value
                    elif code == ABS_PRESSURE:
                        p = value
                elif type_ == EV_KEY and code == BTN_TOOL_RUBBER:
                    rubber = bool(value)
                elif type_ == EV_SYN and code == 0:
                    if p > 0 and not rubber:
                        down = True
                        GLib.idle_add(on_point, *self.to_content(x, y), p / self.max_p)
                    elif down:
                        down = False
                        GLib.idle_add(on_up)
            buf = buf[n:]
        log("pen stream ended")
        GLib.idle_add(Gtk.main_quit)


def mirror_window():
    """The scrcpy window: (xid, x, y, width, height), or None when it isn't
    showing (closed, or on a workspace not in view)."""
    ids = subprocess.run(["xdotool", "search", "--class", "^scrcpy$"],
                         capture_output=True, text=True).stdout.split()
    for xid in ids:
        info = subprocess.run(["xwininfo", "-id", xid], capture_output=True, text=True).stdout
        lines = info.splitlines()
        if len(lines) < 2 or not lines[1].endswith(f'"{TITLE}"'):
            continue
        get = lambda key: int(re.search(key + r":\s+(-?\d+)", info).group(1))
        if "IsViewable" not in info:
            return None
        return (int(xid, 0), get("Absolute upper-left X"), get("Absolute upper-left Y"),
                get("Width"), get("Height"))
    return None


class Stroke:
    def __init__(self):
        self.points = []        # (x, y, pressure) in the cropped picture
        self.lifted = None      # when the pen lifted
        self.before = None      # the mirror under it at that moment


class Overlay(Gtk.Window):
    def __init__(self, pen):
        super().__init__(type=Gtk.WindowType.POPUP)   # unmanaged: stays over fullscreen
        self.pen = pen
        self.color = ink_color()
        self.strokes = []
        self.current = None
        self.mirror = None      # (xid, x, y, w, h) when the stroke started
        self.foreign = None
        self.set_app_paintable(True)
        self.set_visual(self.get_screen().get_rgba_visual())
        self.connect("draw", self.draw)
        self.connect("realize", lambda w: w.input_shape_combine_region(cairo.Region()))
        GLib.timeout_add(CHECK_EVERY, self.check)
        GLib.timeout_add_seconds(2, self.still_mirroring)
        self.missing = 0
        self.drawing = True     # a pen is selected in Notes
        self.checking = False
        self.recheck()

    # ------------------------------------------------------------- geometry

    def scale(self):
        """Cropped picture to window: scrcpy fits it, centered."""
        _, _, _, w, h = self.mirror
        cw, ch = self.pen.crop[2], self.pen.crop[3]
        s = min(w / cw, h / ch)
        return s, (w - cw * s) / 2, (h - ch * s) / 2

    def to_window(self, x, y):
        s, ox, oy = self.scale()
        return ox + x * s, oy + y * s

    # ------------------------------------------------------------- pen

    def point(self, x, y, pressure):
        if self.current is None:
            mirror = mirror_window()
            if mirror is None:          # not in view: nothing to draw over
                self.current = Stroke()
                self.current.hidden = True
                self.current.off_page = False
                return False
            if mirror != self.mirror:
                self.strokes.clear()
                self.mirror = mirror
                xid, mx, my, w, h = mirror
                self.foreign = GdkX11.X11Window.foreign_new_for_display(
                    Gdk.Display.get_default(), xid)
                self.move(mx, my)
                self.resize(w, h)
            self.show()
            self.get_window().raise_()
            self.current = Stroke()
            self.current.hidden = not self.drawing
            self.current.off_page = False
            if self.current.hidden:
                return False
            self.strokes.append(self.current)
        # only on the page: taps on the toolbars (cropped off) draw nothing
        inside = 0 <= x <= self.pen.crop[2] and 0 <= y <= self.pen.crop[3]
        if not inside:
            self.current.off_page = True
        if not self.current.hidden and inside:
            self.current.points.append((x, y, pressure))
            self.queue_draw()
        return False

    def up(self):
        stroke, self.current = self.current, None
        if stroke is None:
            return False
        if stroke.off_page:             # maybe a tap on a toolbar
            self.recheck()
        if stroke.hidden:
            return False
        if not stroke.points:
            self.strokes.remove(stroke)
            return False
        stroke.lifted = time.monotonic()
        stroke.before = self.sample(stroke)
        return False

    # ------------------------------------------------------------- the tool

    def recheck(self):
        """Read the selected tool a little after a tap, and again later (the
        e-ink toolbar can take a moment to update)."""
        for delay in RECHECK:
            GLib.timeout_add(delay, self.read_tool)
        return False

    def read_tool(self):
        if not self.checking:
            self.checking = True
            threading.Thread(target=lambda: GLib.idle_add(self.got_tool, self.pen.pen_selected()),
                             daemon=True).start()
        return False

    def got_tool(self, selected):
        self.checking = False
        if selected is not None and selected != self.drawing:
            self.drawing = selected
            log("pen selected" if selected else "another tool selected: no live ink")
        return False

    # ------------------------------------------------------------- the real stroke

    def sample_points(self, stroke):
        pts = stroke.points
        step = max(1, len(pts) // 24)
        return [self.to_window(x, y) for x, y, _ in pts[::step]]

    def sample(self, stroke):
        """The mirror's darkest pixel near each of up to 24 points of the
        stroke (the window's own pixels, before picom's shader)."""
        pts = self.sample_points(stroke)
        xs = [p[0] for p in pts]
        ys = [p[1] for p in pts]
        x0, y0 = int(max(0, min(xs) - 4)), int(max(0, min(ys) - 4))
        x1 = int(min(self.mirror[3], max(xs) + 5))
        y1 = int(min(self.mirror[4], max(ys) + 5))
        if x1 <= x0 or y1 <= y0:
            return None
        try:
            pb = Gdk.pixbuf_get_from_window(self.foreign, x0, y0, x1 - x0, y1 - y0)
        except Exception:
            pb = None
        if pb is None:
            return None
        data, stride, n = pb.get_pixels(), pb.get_rowstride(), pb.get_n_channels()
        out = []
        for px, py in pts:
            darkest = 255
            for dy in range(-2, 3):
                for dx in range(-2, 3):
                    ix, iy = int(px) - x0 + dx, int(py) - y0 + dy
                    if 0 <= ix < pb.get_width() and 0 <= iy < pb.get_height():
                        i = iy * stride + ix * n
                        luma = (data[i] * 299 + data[i + 1] * 587 + data[i + 2] * 114) // 1000
                        darkest = min(darkest, luma)
            out.append(darkest)
        return out

    def arrived(self, stroke):
        now = self.sample(stroke)
        if now is None or stroke.before is None:
            return False
        changed = sum(1 for a, b in zip(stroke.before, now) if a - b > 60 or b < 90)
        return changed >= CHANGED * len(now)

    def check(self):
        keep = []
        for stroke in self.strokes:
            if stroke.lifted is not None and (
                    time.monotonic() - stroke.lifted > GIVE_UP or self.arrived(stroke)):
                continue
            keep.append(stroke)
        if len(keep) != len(self.strokes):
            self.strokes = keep
            self.queue_draw()
        return True

    def still_mirroring(self):
        """Quit once the mirror has been closed for a few seconds."""
        running = subprocess.run(["pgrep", "-f", f"^scrcpy --window-title {TITLE}( |$)"],
                                 stdout=subprocess.DEVNULL).returncode == 0
        self.missing = 0 if running else self.missing + 1
        if self.missing >= 3:
            log("mirror closed")
            Gtk.main_quit()
        return True

    # ------------------------------------------------------------- drawing

    def draw(self, _widget, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        if not self.strokes or self.mirror is None:
            return
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_source_rgb(*self.color)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        s = self.scale()[0]
        for stroke in self.strokes:
            pts = stroke.points
            if len(pts) == 1:
                pts = pts * 2
            for (x0, y0, p0), (x1, y1, p1) in zip(pts, pts[1:]):
                cr.set_line_width(s * (WIDTH_MIN + (WIDTH_MAX - WIDTH_MIN) * (p0 + p1) / 2))
                cr.move_to(*self.to_window(x0, y0))
                cr.line_to(*self.to_window(x1, y1))
                cr.stroke()


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    serial, crop = sys.argv[1:]
    pen = Pen(serial, crop)
    log(f"pen {pen.device} on {serial}, {pen.max_x}x{pen.max_y}, crop {crop}")
    overlay = Overlay(pen)
    overlay.realize()
    threading.Thread(target=pen.read, args=(overlay.point, overlay.up), daemon=True).start()
    threading.Thread(target=pen.read_touch, args=(overlay.recheck,), daemon=True).start()
    Gtk.main()


if __name__ == "__main__":
    main()
