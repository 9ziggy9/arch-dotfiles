#!/bin/sh
# boox-screen: toggle workspace 10, which shows the Boox screen (scrcpy).
#
# Bound to $mod+s in i3. On workspace 10 it goes back to the workspace you
# came from; anywhere else it goes to workspace 10 and shows the mirror
# there, fullscreen. If the mirror is already running it is not restarted:
# its window is brought to workspace 10, focused and made fullscreen.
#
# USB is used when the Boox is plugged in; otherwise it connects over Wi-Fi
# to the address in ~/.config/boox-screen/ip (kept out of the dotfiles).
#
#   boox-screen --wifi   with the Boox on USB: turn on adb over Wi-Fi
#                        (port 5555) and save its address. Needed again
#                        after every Boox reboot. It restarts adb on the
#                        Boox, so a running mirror is closed.
#
# scrcpy's output goes to ~/.cache/boox-screen.log.

title=Boox
ws=10
port=5555
ipfile="$HOME/.config/boox-screen/ip"

fail() {
    notify-send -u normal "Boox screen" "$1"
    echo "boox-screen: $1" >&2
    exit 1
}

# serial of the Boox plugged in over USB, if any (and allowed)
usb_serial() {
    adb devices -l | awk '$2 == "device" && / usb:/ { print $1; exit }'
}

if [ "$1" = --wifi ]; then
    serial=$(usb_serial)
    [ -n "$serial" ] || fail "Plug the Boox in over USB first (with USB debugging allowed)."
    ip=$(adb -s "$serial" shell ip -4 addr show wlan0 |
        awk '/inet / { sub("/.*", "", $2); print $2; exit }')
    [ -n "$ip" ] || fail "The Boox has no Wi-Fi address. Is it on Wi-Fi?"
    mkdir -p "${ipfile%/*}"
    echo "$ip" >"$ipfile"
    adb -s "$serial" tcpip "$port" >/dev/null || fail "Could not turn on adb over Wi-Fi."
    sleep 2
    adb connect "$ip:$port"
    exit 0
fi

current=$(i3-msg -t get_workspaces |
    python3 -c 'import json, sys; print(next(w["name"] for w in json.load(sys.stdin) if w["focused"]))')
if [ "$current" = "$ws" ]; then
    i3-msg -q "workspace back_and_forth"
    exit 0
fi

i3-msg -q "workspace number $ws"

if pgrep -f -- "scrcpy --window-title $title( |\$)" >/dev/null; then
    i3-msg -q "[class=\"^scrcpy\$\" title=\"^$title\$\"] move to workspace number $ws, focus, fullscreen enable" 2>/dev/null
    exit 0
fi

serial=$(usb_serial)
if [ -z "$serial" ]; then
    [ -s "$ipfile" ] || fail "No Boox on USB, and no Wi-Fi address saved.
Plug it in, or run boox-screen --wifi once with it plugged in."
    serial="$(cat "$ipfile"):$port"
    if [ "$(adb -s "$serial" get-state 2>/dev/null)" != device ]; then
        timeout 5 adb connect "$serial" >/dev/null 2>&1
    fi
    state=$(adb -s "$serial" get-state 2>&1)
    [ "$state" = device ] || fail "Could not reach the Boox at $serial.
Is it awake and on Wi-Fi? After a Boox reboot, plug it in and run boox-screen --wifi.
($state)"
fi

# --no-audio: the Boox has no opus encoder, and scrcpy quits without it
mkdir -p "$HOME/.cache"
setsid -f scrcpy --window-title "$title" -s "$serial" --stay-awake --no-audio \
    >"$HOME/.cache/boox-screen.log" 2>&1
