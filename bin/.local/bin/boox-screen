#!/bin/sh
# boox-screen: toggle workspace 10, which shows the Boox screen (scrcpy).
#
# Bound to $mod+s in i3. On workspace 10 it goes back to the workspace you
# came from; anywhere else it goes to workspace 10 and shows the mirror
# there, fullscreen. If the mirror is already running it is not restarted:
# its window is brought to workspace 10, focused and made fullscreen.
#
# USB is used when the Boox is plugged in; otherwise it connects over Wi-Fi
# to the address in ~/.config/boox-screen/ip (kept out of the dotfiles).
#
# A Boox reboot turns adb over Wi-Fi off. So whenever the mirror starts
# over USB, Wi-Fi is turned back on first (port 5555) and the Boox's
# address saved: after any plugged-in $mod+s, unplugging and pressing
# $mod+s again reconnects over Wi-Fi.
#
#   boox-screen --wifi   with the Boox on USB: do just that by hand. It
#                        restarts adb on the Boox, so a running mirror
#                        is closed.
#
# The mirror is cropped to hide the Notes toolbars (see crop below).
#
# scrcpy's output goes to ~/.cache/boox-screen.log.

title=Boox
ws=10
port=5555
ipfile="$HOME/.config/boox-screen/ip"
# Cut the Notes app's toolbars (left 144 px, top 116 px of the 2480x1860
# landscape screen) out of the mirror; the Boox itself keeps them. scrcpy
# takes the crop in the panel's portrait orientation, so it reads
# height:width:top:left. Sizes are multiples of 16 for the encoder.
# Measured for Notes in this landscape orientation only.
crop=1744:2336:116:144

fail() {
    notify-send -u normal "Boox screen" "$1"
    echo "boox-screen: $1" >&2
    exit 1
}

# serial of the Boox plugged in over USB, if any (and allowed)
usb_serial() {
    adb devices -l | awk '$2 == "device" && / usb:/ { print $1; exit }'
}

# with the Boox on USB ($1): save its Wi-Fi address and make adb listen on
# $port, unless it already does. Prints the address; returns 1 without one.
arm_wifi() {
    ip=$(adb -s "$1" shell ip -4 addr show wlan0 |
        awk '/inet / { sub("/.*", "", $2); print $2; exit }')
    [ -n "$ip" ] || return 1
    mkdir -p "${ipfile%/*}"
    echo "$ip" >"$ipfile"
    if [ "$(adb -s "$1" shell getprop service.adb.tcp.port | tr -d '\r')" != "$port" ]; then
        adb -s "$1" tcpip "$port" >/dev/null || return 1
        # adb restarts on the Boox; wait for it to come back on USB
        sleep 2
        timeout 15 adb -s "$1" wait-for-usb-device
    fi
    echo "$ip"
}

if [ "$1" = --wifi ]; then
    serial=$(usb_serial)
    [ -n "$serial" ] || fail "Plug the Boox in over USB first (with USB debugging allowed)."
    ip=$(arm_wifi "$serial") || fail "Could not turn on adb over Wi-Fi. Is the Boox on Wi-Fi?"
    adb connect "$ip:$port"
    exit 0
fi

current=$(i3-msg -t get_workspaces |
    python3 -c 'import json, sys; print(next(w["name"] for w in json.load(sys.stdin) if w["focused"]))')
if [ "$current" = "$ws" ]; then
    i3-msg -q "workspace back_and_forth"
    exit 0
fi

i3-msg -q "workspace number $ws"

if pgrep -f -- "scrcpy --window-title $title( |\$)" >/dev/null; then
    i3-msg -q "[class=\"^scrcpy\$\" title=\"^$title\$\"] move to workspace number $ws, focus, fullscreen enable" 2>/dev/null
    exit 0
fi

serial=$(usb_serial)
if [ -n "$serial" ]; then
    # not fatal: the USB mirror works without Wi-Fi
    arm_wifi "$serial" >/dev/null ||
        notify-send -u low "Boox screen" "Could not turn on adb over Wi-Fi (is the Boox on Wi-Fi?)."
else
    [ -s "$ipfile" ] || fail "No Boox on USB, and no Wi-Fi address saved.
Plug it in, or run boox-screen --wifi once with it plugged in."
    serial="$(cat "$ipfile"):$port"
    if [ "$(adb -s "$serial" get-state 2>/dev/null)" != device ]; then
        timeout 5 adb connect "$serial" >/dev/null 2>&1
    fi
    state=$(adb -s "$serial" get-state 2>&1)
    [ "$state" = device ] || fail "Could not reach the Boox at $serial.
Is it awake and on Wi-Fi? After a Boox reboot, plug it in and press \$mod+s once.
($state)"
fi

# --no-audio: the Boox has no opus encoder, and scrcpy quits without it
mkdir -p "$HOME/.cache"
setsid -f scrcpy --window-title "$title" -s "$serial" --stay-awake --no-audio --crop="$crop" \
    >"$HOME/.cache/boox-screen.log" 2>&1
