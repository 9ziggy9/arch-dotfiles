# Template for the i3bar block. bar-theme.py (run by theme-select) fills in
# the background and statusline placeholders below from the kitty theme and
# writes the result to bar.conf, which ~/.config/i3/config includes. Edit the
# bar here, not in bar.conf: that file is regenerated on every theme switch.
bar {
        position top
        status_command ~/.config/bumblebee-status/launch.sh
        font pango:FiraCode Nerd Font 9
        # the focused workspace number is drawn by the status line instead
        workspace_buttons no

        colors {
            background @background@
            statusline @statusline@
            separator #928374

            #                    border  background  text
            focused_workspace #93a1a1 #93a1a1 #002b36
            active_workspace #002b36 #002b36 #93a1a1
            inactive_workspace #002b36 #002b36 #93a1a1
            urgent_workspace #dc322f #dc322f #002b36
        }
}
